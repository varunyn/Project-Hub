{
  "name": "project-hub",
  "version": "0.4.1",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev -p 3080",
    "build": "pnpm build:mcp && next build",
    "build:mcp": "tsc -p mcp/tsconfig.json && node scripts/fix-mcp-imports.mjs",
    "start": "next start -p 3080",
    "start:mcp": "node mcp/dist/mcp/server.js",
    "lint": "biome check .",
    "test": "pnpm build:mcp && node --test tests/*.test.mjs",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci",
    "report:dependencies": "node scripts/run-dependency-reporter.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tailwindcss/typography": "^0.5.16",
    "next": "16.3.0",
    "preline": "^4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "simple-icons": "^16.7.0",
    "swr": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "ultracite": "7.8.0"
  },
  "overrides": {
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3"
  }
}
