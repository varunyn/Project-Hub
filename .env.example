# Copy to .env and set your path. Used by docker-compose for the projects volume.
# Parent directory that contains all project paths (e.g. your home or Documents).
HOST_PROJECTS_PATH=/path/to/your/projects

# Persist project records outside the container image.
PROJECT_DATA_PATH=./app/data

# Allows Docker to regenerate report JSON from the fixed reporter script.
# Python projects use lockfile/spec scanning when a local venv is not runnable in Docker.
DEPENDENCY_REPORT_RUN_ENABLED=true
DEPENDENCY_REPORT_RELEASE_INTELLIGENCE_ENABLED=true
DEPENDENCY_REPORT_RELEASE_MAX_PACKAGES=25

# Optional AI summaries for dependency report runs started from the app.
# Use host.docker.internal when the app is running in Docker and the AI endpoint is on the host Mac.
DEPENDENCY_REPORT_AI_ENABLED=false
DEPENDENCY_REPORT_AI_BASE_URL=http://host.docker.internal:3001/v1
DEPENDENCY_REPORT_AI_MODEL=meta.llama-4-scout-17b-16e-instruct
DEPENDENCY_REPORT_AI_KEY_ENV=

# Command shown in the empty state. The app generates the config from projects.json.
DEPENDENCY_REPORT_COMMAND=python3 /app/tools/dependency-reporter/dependency_reporter.py --config "<generated from projects.json>"
