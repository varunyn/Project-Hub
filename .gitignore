# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
package-lock.json
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

/docs

# next.js
/.next/
/out/

# production
/build
/mcp/dist

# misc
.DS_Store
*.pem
app.pid
logs.txt

# local project data (user-specific, do not commit)
app/data/projects*.json
app/data/tasks*.json
app/data/dependency-report-job.json
app/data/dependency-report-ai-preferences.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python (uv venv at repo root for tooling)
.venv
__pycache__/
*.pyc
*.pyo

.cursor
# next-agents-md
.next-docs/

.cursor/
.agents/
skills-lock.json

# generated dependency reporter output
outputs/dependency-report-*.json
outputs/dependency-report-*.md
outputs/dependency-report-cache.json
app/data/dependency-reports/
app/data/dependency-report-cache.json
.codegraph
