{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "vcs": { "enabled": true, "clientKind": "git" },
  "files": {
    "includes": [
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/build",
      "!**/mcp",
      "!**/app/data",
      "!**/*.config.js",
      "!**/*.config.mjs",
      "!**/*.config.ts",
      "!**/pnpm-lock.yaml",
      "!**/package-lock.json",
      "!**/app/globals.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "noDuplicateClasses": "on",
        "useSortedAttributes": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noAutofocus": "warn",
        "noLabelWithoutControl": "warn",
        "useButtonType": "warn",
        "useAriaPropsSupportedByRole": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noForEach": "off"
      },
      "performance": {
        "useTopLevelRegex": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "useAtIndex": "off",
        "useBlockStatements": "off",
        "useConsistentArrowReturn": "off",
        "useFilenamingConvention": "off"
      },
      "suspicious": {
        "noAlert": "off",
        "noBiomeFirstException": "off",
        "noArrayIndexKey": "warn",
        "useAwait": "off",
        "useIterableCallbackReturn": "warn"
      },
      "nursery": {
        "useSortedClasses": "off"
      }
    }
  }
}
